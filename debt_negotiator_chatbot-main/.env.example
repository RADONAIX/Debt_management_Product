# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=

# Model roles (CLAUDE.md §9). Only COLLECTOR is reachable in production.
#
# gpt-5.5 is stronger but REJECTS the temperature parameter, which §9 requires
# (low-but-non-zero for COLLECTOR, exactly 0 for JUDGE). gpt-5.4 is the
# strongest model that honours both. JUDGE is a different family on purpose,
# to reduce self-preference bias.
NEGOTIATOR_COLLECTOR_MODEL=gpt-5.4
NEGOTIATOR_COLLECTOR_TEMPERATURE=0.3
NEGOTIATOR_JUDGE_MODEL=gpt-4.1
NEGOTIATOR_JUDGE_TEMPERATURE=0.0
NEGOTIATOR_SIMULATOR_MODEL=gpt-5.4
NEGOTIATOR_SIMULATOR_TEMPERATURE=0.8
NEGOTIATOR_SYNTHESIS_MODEL=gpt-5.4
NEGOTIATOR_SYNTHESIS_TEMPERATURE=1.0

# Hard per-run spend ceilings. The harness runs hundreds of dialogues.
NEGOTIATOR_MAX_CALLS_PER_RUN=1500
NEGOTIATOR_MAX_TOKENS_PER_RUN=4000000

# off | record | replay. Tests run in replay so they never call out.
NEGOTIATOR_CASSETTE_MODE=off

# Postgres. Tables are confined to the `chatbot` schema.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
SQL_ECHO=false
