# ---------------------------------------------------------------------------
# RADONaix Assure+ backend — environment configuration
# Copy to `.env` and adjust. Never commit a real `.env`.
# ---------------------------------------------------------------------------

# --- General ---
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
API_PREFIX=/api
# Comma-separated allowed origins (the Assure+ UI dev server). "*" for all (dev only).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- Auth / JWT ---
# Generate a strong secret, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
# With ENVIRONMENT=production the app REFUSES to start if JWT_SECRET is a known
# default / under 32 chars, or if BOOTSTRAP_ADMIN_PASSWORD is the default.
JWT_SECRET=change-me-please-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
BOOTSTRAP_ADMIN_EMAIL=admin@radonaix.io
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!123
# Per-IP rate limit on POST /auth/login (brute-force speed bump).
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- App database (owned by this service) ---
APP_DB_HOST=127.0.0.1
APP_DB_PORT=5432
APP_DB_NAME=Debt_management_db
APP_DB_USER=assure
APP_DB_PASSWORD=assure
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false
